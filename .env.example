# Defaults use a deterministic local provider. No API key is required.
NODE_ENV=development
FORGEFLOW_LOG_LEVEL=info
DATABASE_PATH=data/forgeflow.db
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2

# Required only when LLM_PROVIDER=deepseek.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
