# Defaults use a deterministic local provider. No API key is required.
NODE_ENV=development
FORGEFLOW_LOG_LEVEL=info
DATABASE_PATH=data/forgeflow.db
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_CONTEXT_MAX_TOKENS=16384
LLM_CONTEXT_RESERVED_COMPLETION_TOKENS=2048
LLM_TOOL_RESULT_MAX_TOKENS=1024
LOOP_GUARD_REPEAT_THRESHOLD=3
LOOP_GUARD_CYCLE_REPETITIONS=3
LOOP_GUARD_FAILURE_THRESHOLD=3
LOOP_GUARD_MAX_HISTORY_ROUNDS=12
DEMO_MAX_MODEL_TURNS=10
DEMO_MAX_TOOL_CALLS=24

# Required only when LLM_PROVIDER=deepseek.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# Web application. Anonymous guests are signed with this server-only secret.
WEB_HOST=127.0.0.1
WEB_PORT=8787
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_SECURE_COOKIES=false
WEB_SESSION_TTL_SECONDS=604800
WEB_TRUST_PROXY=false
WEB_GUEST_SESSION_RATE_LIMIT_PER_MINUTE=20
WEB_GUEST_TASK_RATE_LIMIT_PER_MINUTE=10
WEB_MAX_ACTIVE_TASKS=2
WEB_DAILY_TASK_LIMIT=25
WEB_GUEST_DAILY_MODEL_TASK_LIMIT=5
WEB_DEFAULT_MODEL_TURNS=8
WEB_DEFAULT_TOOL_CALLS=20
WEB_DEFAULT_TOKEN_BUDGET=50000
WEB_APPROVAL_TIMEOUT_MS=300000
WEB_ALLOW_PAID_PROVIDER=false
WEB_GLOBAL_PROVIDER_CONCURRENCY=2
WEB_GLOBAL_MODEL_TOKEN_BUDGET_PER_DAY=0
WEB_ENABLE_PUBLIC_EVALUATION_RUN=true
WEB_EVALUATION_RUNS_PER_HOUR=3
