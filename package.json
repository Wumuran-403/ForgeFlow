{
  "name": "forgeflow",
  "version": "0.1.0",
  "private": true,
  "description": "A resumable agent runtime for hardware engineering workflows.",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "dev:web": "tsx scripts/dev-web.ts",
    "dev:api": "tsx watch src/web/server.ts",
    "dev:ui": "vite --config web/vite.config.ts",
    "demo:mock": "tsx src/demo/stm32-demo-cli.ts --mock",
    "demo:deepseek": "tsx src/demo/stm32-demo-cli.ts --deepseek",
    "mcp:demo": "tsx src/mcp/demo-server.ts",
    "eval:phase6": "tsx scripts/run-phase6-evaluation.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:start": "tsx src/web/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.9",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
